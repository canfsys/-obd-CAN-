# 统一行尾为 LF, 避免跨平台差异
* text=auto

# 明确指定文本文件
*.c text
*.h text
*.md text
*.json text
*.txt text
*.yml text
*.yaml text
CMakeLists.txt text
*.sh text eol=lf
Dockerfile text

# 二进制文件
*.bin binary
*.elf binary
*.map binary
*.pdf binary
*.png binary
*.jpg binary
*.ico binary

# 硬件设计文件 (Gerber/钻孔/Excel)
*.gbr binary
*.drl binary
*.xlsx binary
*.zip binary
*.eprj2 binary
# 嘉立创 Gerber 制造文件 (按二进制处理, 避免行尾转换影响制造数据)
hardware/gerber/*.GTL binary
hardware/gerber/*.GBL binary
hardware/gerber/*.GTO binary
hardware/gerber/*.GBO binary
hardware/gerber/*.GTS binary
hardware/gerber/*.GBS binary
hardware/gerber/*.GTP binary
hardware/gerber/*.GBP binary
hardware/gerber/*.GKO binary
hardware/gerber/*.GDL binary
hardware/gerber/*.GDD binary
hardware/gerber/*.G1 binary
hardware/gerber/*.G2 binary
hardware/gerber/*.DRL binary
hardware/gerber/*.json binary

