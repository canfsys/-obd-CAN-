# ============================================================
# 根目录 .gitignore (Monorepo: esp32/ + miniprogram/ + iot/)
# ============================================================

# === 通用 ===
# macOS
.DS_Store
.AppleDouble
.LSOverride

# 目录元数据
.directory

# 临时文件
*~
*.swp
*.swo
*.bak
*.tmp

# 日志文件
*.log

# === ESP32 固件 (esp32/) ===
# Build artifacts and directories
build/
**/build/
*.o
*.a
*.out
*.exe

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json
sdkconfig
sdkconfig.old

# ESP-IDF dependencies
/components/.idf/
**/components/.idf/
managed_components/
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# === 微信小程序 (miniprogram/) ===
**/node_modules/
miniprogram/project.private.config.json
miniprogram/miniprogram_npm/
miniprogram/.eslintrc.js

# === 文件系统 ===
Thumbs.db
ehthumbs.db
Desktop.ini

# === VS Code (本地个人配置, 含本机工具链路径/串口号, 不应公开) ===
.vscode/

# === Python 环境 ===
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/
venv/
.venv/
env/
